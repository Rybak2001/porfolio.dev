---
const personalImageAlt = "Pedro Chacolla"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-xl" data-anim="anim-fade-up">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16 anim-scale-bounce"
      src="/me.png"
      alt={personalImageAlt}
    />
    <a
      href="https://linkedin.com/in/pedro-chacolla-b18918359"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white anim-tracking-in delay-2"
  >
    Hey, soy Pedro Chacolla
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300 anim-fade-up delay-4"
  >
    +4 años de experiencia. <strong
      >Egresado en Ingeniería de Sistemas y desarrollador Full-Stack</strong
    > de La Paz, Bolivia. Especializado en desarrollo web (Next.js, Angular, .NET) y aplicaciones Android nativas con Kotlin.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8 anim-fade-up delay-6">
    <SocialPill href="mailto:chacolla43@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/pedro-chacolla-b18918359">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/Rybak1234">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
  <div class="flex flex-wrap gap-3 mt-4 anim-fade-up delay-7">
    <a href="/cv-casual.html" target="_blank" class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-gray-300 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:border-purple-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
      CV Casual
    </a>
    <a href="/cv-harvard.html" target="_blank" class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-gray-300 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:border-purple-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
      CV Harvard
    </a>
  </div>
</div>
