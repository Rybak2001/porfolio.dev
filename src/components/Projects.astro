    class: "bg-[#336791] text-white",
    icon: PostgreSQL,
  },
  FLUTTER: {
    name: "Flutter",
    class: "bg-[#027DFD] text-white",
    icon: Flutter,
  },
  PHP: {
    name: "PHP 8",
    class: "bg-[#777BB4] text-white",
