const STACKS = [
  {
    name: "Next.js Full-Stack (Next.js + Prisma + PostgreSQL + Tailwind)",
    projects: [
      {
        title: "SurtiBolivia E-Commerce",
        description:
          "Plataforma e-commerce completa con catálogo de productos, carrito de compras, pasarela de pagos Stripe, panel de administración, gestión de vendors, sistema de reviews, cupones de descuento, flash deals, sección de Moda Boliviana por departamento y búsqueda avanzada con Ctrl+K. Autenticación con NextAuth y base de datos PostgreSQL en Neon.",
        link: "https://smb-commerce-platform.vercel.app",
        image: "/projects/surtibolivia-ecommerce.webp",
        tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.PRISMA, TAGS.NEON, TAGS.VERCEL],
      },
      {
        title: "Inventario SurtiBolivia",
        description:
          "Sistema de gestión de inventario empresarial. Control de stock en tiempo real, movimientos de entrada/salida con historial, alertas de stock bajo, gestión de usuarios por roles (admin, gestor, empleado), subida de imágenes, búsqueda y filtros avanzados. Comparte base de datos con el e-commerce para sincronización automática.",
        link: "https://retail-inventory-platform-gamma.vercel.app",
        image: "/projects/inventario-surtibolivia.webp",
        tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.PRISMA, TAGS.NEON, TAGS.VERCEL],
      },
      {
        title: "NovaTech RRHH — Recursos Humanos",
        description:
          "Sistema completo de gestión de recursos humanos. Administración de empleados, departamentos, cálculo de nóminas, control de asistencias, reportes analíticos y dashboard interactivo. Autenticación segura y gestión de roles.",
        link: "https://novatech-rrhh.vercel.app",
        image: "/projects/novatech-rrhh.webp",
        tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.PRISMA, TAGS.NEON, TAGS.VERCEL],
      },
      {
        title: "Dashboard Analítica en Tiempo Real",
        description:
          "Panel de visualización en tiempo real con WebSockets y Pusher. Gráficas interactivas con Chart.js, filtros dinámicos, exportación CSV/PDF. Arquitectura orientada a eventos con actualizaciones push instantáneas.",
        link: "https://realtime-ops-dashboard.vercel.app",
        image: "/projects/realtime-dashboard.webp",
        tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.MONGODB, TAGS.VERCEL],
      },
      {
        title: "Collaborative Workboard",
        description:
          "Tablero Kanban colaborativo en tiempo real con drag & drop, asignación de tareas, WebSockets con Pusher para sincronización entre usuarios, notificaciones en vivo y filtros por estado y prioridad.",
        link: "https://collaborative-workboard.vercel.app",
        image: "/projects/collaborative-workboard.webp",
        tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.MONGODB, TAGS.VERCEL],
      },
    ],
  },
  {
    name: "Nuxt Full-Stack (Nuxt 4 + Vue 3 + Prisma + PostgreSQL)",
    projects: [
      {
        title: "NovaTech Contabilidad",
        description:
          "Sistema de contabilidad empresarial con plan de cuentas, libro diario, libro mayor, balance general y estado de resultados. Dashboard con gráficas Chart.js, autenticación JWT y gestión de períodos contables.",
        link: "https://novatech-contabilidad.vercel.app",
        image: "/projects/novatech-contabilidad.webp",
        tags: [TAGS.NUXT, TAGS.TAILWIND, TAGS.PRISMA, TAGS.POSTGRESQL, TAGS.VERCEL],
      },
    ],
  },
  {
    name: "MEAN Stack (MongoDB + Express + Angular + Node.js)",
    projects: [
      {
        title: "QA Test Suite",
        description:
          "Suite profesional de testing y QA para todo el ecosistema SurtiBolivia. 10 suites con +90 tests reales contra APIs de producción. Dashboard con métricas en tiempo real, historial de ejecuciones, modo oscuro, sistema de notificaciones, configuración avanzada, atajos de teclado y exportación CSV.",
        link: "https://web-quality-test-suite.vercel.app",
        image: "/projects/qa-test-suite.webp",
        tags: [TAGS.ANGULAR, TAGS.NODE, TAGS.VERCEL],
      },
    ],
  },
  {
    name: "Móvil & Backend Web (Flutter · Kotlin · PHP + MySQL)",
    projects: [
      {
        title: "Habit Tracker Flutter",
        description:
          "App de seguimiento de hábitos cross-platform desarrollada con Flutter y Dart. Streaks automáticos, estadísticas de progreso, notificaciones y Material You. Arquitectura con Provider pattern y shared_preferences.",
        link: "https://habit-tracker-flutter-rho.vercel.app",
        github: "https://github.com/Rybak2001/habit-tracker-flutter",
        image: "/projects/habit-tracker-flutter.webp",
        tags: [TAGS.FLUTTER, TAGS.VERCEL],
      },
      {
        title: "Habit Tracker Android",
        description:
          "App Android nativa con Kotlin, arquitectura MVVM, Room DB para persistencia local, LiveData para reactividad y Material You. Gestión completa de hábitos con histórico de completados y estadísticas.",
        github: "https://github.com/Rybak2001/habit-tracker-android",
        image: "/projects/habit-tracker-android.webp",
        tags: [TAGS.KOTLIN],
      },
      {
        title: "PHP MySQL Panel",
        description:
          "Panel de gestión de productos con CRUD completo en PHP nativo, PDO MySQL, autenticación por sesión y API REST serverless. Interfaz dark-mode responsiva. Desplegado en Vercel con runtime vercel-php.",
        link: "https://php-mysql-panel.vercel.app",
        github: "https://github.com/Rybak2001/php-mysql-panel",
        image: "/projects/php-mysql-panel.webp",
        tags: [TAGS.PHP, TAGS.MYSQL, TAGS.VERCEL],
      },
    ],
  },
]
---

<div class="flex flex-col gap-y-16">
  {
    STACKS.map((stack, si) => (
      <div>
        <h3
          data-anim="anim-fade-right"
          class={`text-lg font-semibold text-purple-600 dark:text-purple-400 mb-8 delay-${si + 1}`}
        >
          {stack.name}
        </h3>
        <div class="flex flex-col gap-y-16">
          {stack.projects.map((project, i) => (
            <article data-anim="anim-fade-up" class={`flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0 delay-${i + 1}`}>
              <div class="w-full md:w-1/2">
                <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
                  <img alt={project.title} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="eager" src={project.image} />
                </div>
              </div>

              <div class="w-full md:w-1/2 md:max-w-lg">
                <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
                  {project.title}
                </h3>
                <div class="flex flex-wrap mt-2">
                  <ul class="flex flex-row flex-wrap mb-2 gap-2">
                    {project.tags.map((tag) => (
                      <li>
                        <span
                          class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                        >
                          <tag.icon class="size-4" />
                          {tag.name}
                        </span>
                      </li>
                    ))}
                  </ul>

                  <div class="mt-2 text-gray-700 dark:text-gray-400">{project.description}</div>
                  <footer class="flex items-end justify-start mt-4 gap-x-4">
                    {"github" in project && (
                      <LinkButton href={project.github}>
                        <GitHub class="size-6" />
                        Code
                      </LinkButton>
                    )}
                    {"link" in project && (
                      <LinkButton href={project.link}>
                        <Link class="size-4" />
                        Preview
                      </LinkButton>
                    )}
                  </footer>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))
  }
</div>
