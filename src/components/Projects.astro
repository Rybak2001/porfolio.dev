  },
  ANGULAR: {
    name: "Angular",
    class: "bg-[#DD0031] text-white",
    icon: Angular,
  },
  KOTLIN: {
    name: "Kotlin",
    class: "bg-[#7F52FF] text-white",
    icon: Kotlin,
  },
  VERCEL: {
    name: "Vercel",
    class: "bg-black text-white",
    icon: Vercel,
  },
  PRISMA: {
    name: "Prisma",
    class: "bg-[#2D3748] text-white",
    icon: Prisma,
  },
  NEON: {
    name: "Neon DB",
    class: "bg-[#00E699] text-black",
    icon: PostgreSQL,
  },
  NODE: {
    name: "Node.js",
    class: "bg-[#339933] text-white",
    icon: NodeJS,
