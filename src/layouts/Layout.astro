---
import "@fontsource-variable/onest"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { ViewTransitions } from "astro:transitions"

interface Props {
  title: string
  description: string
}

const { description, title } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      // Prevent FOUC: apply theme before paint
      (function() {
        const theme = localStorage.getItem("theme") || "dark";
        const isDark = theme === "dark" || (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (isDark || theme !== "light") document.documentElement.classList.add("dark");
      })();
    </script>
  </head>

  <body class="relative text-black dark:text-white">
    <div class="bg-anim-layer" aria-hidden="true"></div>
    <div class="bg-noise-overlay" aria-hidden="true"></div>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      /* ══════════════════════════════════════════════════════
         ANIMATED BACKGROUND
         ══════════════════════════════════════════════════════ */
      .bg-anim-layer {
        position: fixed;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        background-size: 400% 400%;
        animation: gradientDark 14s ease infinite;
        background-image: linear-gradient(
          -45deg,
          #020011 0%,
          #0d0026 25%,
          #130042 50%,
          #06002a 75%,
          #000018 100%
        );
      }

      html:not(.dark) .bg-anim-layer {
        animation-name: gradientLight;
        background-image: linear-gradient(
          -45deg,
          #f8f0ff 0%,
          #ede0ff 25%,
          #ddd6fe 50%,
          #e0f2fe 75%,
          #fdf4ff 100%
        );
      }

      /* dark aurora overlay */
      .bg-anim-layer::before {
        content: "";
        position: absolute;
        inset: 0;
        background-size: 300% 300%;
        animation: auroraMove 18s ease-in-out infinite alternate;
        background-image: radial-gradient(ellipse 80% 60% at 20% 30%, rgba(99,51,255,0.35) 0%, transparent 60%),
                          radial-gradient(ellipse 60% 50% at 80% 70%, rgba(16,185,129,0.20) 0%, transparent 55%),
                          radial-gradient(ellipse 50% 40% at 50% 10%, rgba(168,85,247,0.30) 0%, transparent 50%);
        mix-blend-mode: screen;
        pointer-events: none;
      }

      html:not(.dark) .bg-anim-layer::before {
        background-image: radial-gradient(ellipse 80% 60% at 20% 30%, rgba(167,139,250,0.45) 0%, transparent 60%),
                          radial-gradient(ellipse 60% 50% at 80% 70%, rgba(196,181,253,0.35) 0%, transparent 55%),
                          radial-gradient(ellipse 50% 40% at 50% 10%, rgba(251,207,232,0.50) 0%, transparent 50%);
        mix-blend-mode: multiply;
      }

      /* subtle noise texture */
      .bg-noise-overlay {
        position: fixed;
        inset: 0;
        z-index: -1;
        opacity: 0.035;
        pointer-events: none;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        background-size: 200px 200px;
      }

      @keyframes gradientDark {
        0%   { background-position: 0% 50%; background-image: linear-gradient(-45deg,#020011,#0d0026,#1a0050,#06002a,#000018); }
        25%  { background-position: 50% 0%; background-image: linear-gradient(-45deg,#080020,#150040,#230060,#0d0035,#040015); }
        50%  { background-position: 100% 50%; background-image: linear-gradient(-45deg,#0a0030,#180050,#06001a,#0e0040,#010010); }
        75%  { background-position: 50% 100%; background-image: linear-gradient(-45deg,#050018,#0b0030,#160045,#080028,#020012); }
        100% { background-position: 0% 50%; background-image: linear-gradient(-45deg,#020011,#0d0026,#1a0050,#06002a,#000018); }
      }

      @keyframes gradientLight {
        0%   { background-position: 0% 50%; background-image: linear-gradient(-45deg,#fdf4ff,#ede0ff,#ddd6fe,#e0f2fe,#f0fdf4); }
        25%  { background-position: 50% 0%; background-image: linear-gradient(-45deg,#fce7f3,#f3e8ff,#e0e7ff,#dbeafe,#ecfdf5); }
        50%  { background-position: 100% 50%; background-image: linear-gradient(-45deg,#f5f3ff,#ede9fe,#ddd6fe,#cffafe,#fdf4ff); }
        75%  { background-position: 50% 100%; background-image: linear-gradient(-45deg,#fdf2f8,#fae8ff,#e0d7ff,#e0f7ff,#f0fff4); }
        100% { background-position: 0% 50%; background-image: linear-gradient(-45deg,#fdf4ff,#ede0ff,#ddd6fe,#e0f2fe,#f0fdf4); }
      }

      @keyframes auroraMove {
        0%   { background-position: 0% 0%; }
        33%  { background-position: 100% 50%; }
        66%  { background-position: 50% 100%; }
        100% { background-position: 0% 0%; }
      }

      @media (prefers-reduced-motion: reduce) {
        .bg-anim-layer, .bg-anim-layer::before {
          animation: none;
        }
      }

      :root {
        color-scheme: dark;
      }

      html:not(.dark) {
        color-scheme: light;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      .dark body,
      html.dark body {
        color: rgba(255, 255, 255, 0.9);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      #header-nav {
        animation: blur linear both 0.5s;
        animation-timeline: scroll();
        animation-range: 0 500px;
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(0, 0, 0);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgb(229, 229, 229);
          border-radius: 9999px;
        }
      }

      html.dark #header-nav {
        animation-name: blur-dark;
      }

      @keyframes blur-dark {
        from {
          border: 0px;
        }
        to {
          box-shadow:
            0px 5px 50px -5px rgba(0, 0, 0, 0.1),
            0px 0px 0 1px rgba(0, 0, 0, 0.3);
          background: rgba(0, 0, 0, 0.3);
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(0, 0, 0);
          padding-left: 0.75rem;
          padding-right: 0.75rem;
          padding-top: 0.25rem;
          padding-bottom: 0.25rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgba(0, 0, 0, 0.3);
          border-radius: 9999px;
        }
      }

      /* ══════════════════════════════════════════════════════
         50 ANIMATIONS SYSTEM
         ══════════════════════════════════════════════════════ */

      /* 1. Fade In */
      @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
      .anim-fade-in { animation: fadeIn 0.6s ease-out both; }

      /* 2. Fade Up */
      @keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
      .anim-fade-up { animation: fadeUp 0.7s ease-out both; }

      /* 3. Fade Down */
      @keyframes fadeDown { from { opacity: 0; transform: translateY(-30px); } to { opacity: 1; transform: translateY(0); } }
      .anim-fade-down { animation: fadeDown 0.7s ease-out both; }

      /* 4. Fade Left */
      @keyframes fadeLeft { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
      .anim-fade-left { animation: fadeLeft 0.7s ease-out both; }

      /* 5. Fade Right */
      @keyframes fadeRight { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } }
      .anim-fade-right { animation: fadeRight 0.7s ease-out both; }

      /* 6. Scale In */
      @keyframes scaleIn { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }
      .anim-scale-in { animation: scaleIn 0.5s ease-out both; }

      /* 7. Scale Bounce */
      @keyframes scaleBounce { 0% { opacity: 0; transform: scale(0.3); } 50% { transform: scale(1.05); } 100% { opacity: 1; transform: scale(1); } }
      .anim-scale-bounce { animation: scaleBounce 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) both; }

      /* 8. Rotate In */
      @keyframes rotateIn { from { opacity: 0; transform: rotate(-15deg) scale(0.9); } to { opacity: 1; transform: rotate(0) scale(1); } }
      .anim-rotate-in { animation: rotateIn 0.6s ease-out both; }

      /* 9. Flip X */
      @keyframes flipX { from { opacity: 0; transform: perspective(400px) rotateX(90deg); } to { opacity: 1; transform: perspective(400px) rotateX(0); } }
      .anim-flip-x { animation: flipX 0.7s ease-out both; }

      /* 10. Flip Y */
      @keyframes flipY { from { opacity: 0; transform: perspective(400px) rotateY(90deg); } to { opacity: 1; transform: perspective(400px) rotateY(0); } }
      .anim-flip-y { animation: flipY 0.7s ease-out both; }

      /* 11. Blur In */
      @keyframes blurIn { from { opacity: 0; filter: blur(12px); } to { opacity: 1; filter: blur(0); } }
      .anim-blur-in { animation: blurIn 0.6s ease-out both; }

      /* 12. Slide Up */
      @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
      .anim-slide-up { animation: slideUp 0.5s ease-out both; }

      /* 13. Slide Down */
      @keyframes slideDown { from { transform: translateY(-100%); } to { transform: translateY(0); } }
      .anim-slide-down { animation: slideDown 0.5s ease-out both; }

      /* 14. Bounce In */
      @keyframes bounceIn { 0% { opacity: 0; transform: scale(0.3); } 40% { transform: scale(1.1); } 70% { transform: scale(0.95); } 100% { opacity: 1; transform: scale(1); } }
      .anim-bounce-in { animation: bounceIn 0.8s cubic-bezier(0.215, 0.61, 0.355, 1) both; }

      /* 15. Elastic In */
      @keyframes elasticIn { 0% { opacity: 0; transform: scale(0.5); } 70% { transform: scale(1.1); } 85% { transform: scale(0.97); } 100% { opacity: 1; transform: scale(1); } }
      .anim-elastic-in { animation: elasticIn 0.9s cubic-bezier(0.68, -0.55, 0.265, 1.55) both; }

      /* 16. Float */
      @keyframes floatAnim { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
      .anim-float { animation: floatAnim 3s ease-in-out infinite; }

      /* 17. Pulse */
      @keyframes pulseAnim { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
      .anim-pulse { animation: pulseAnim 2s ease-in-out infinite; }

      /* 18. Wiggle */
      @keyframes wiggle { 0%,100% { transform: rotate(0); } 15% { transform: rotate(5deg); } 30% { transform: rotate(-5deg); } 45% { transform: rotate(3deg); } 60% { transform: rotate(-3deg); } 75% { transform: rotate(1deg); } }
      .anim-wiggle { animation: wiggle 0.8s ease-in-out; }

      /* 19. Shake X */
      @keyframes shakeX { 0%,100% { transform: translateX(0); } 10%,30%,50%,70%,90% { transform: translateX(-4px); } 20%,40%,60%,80% { transform: translateX(4px); } }
      .anim-shake-x { animation: shakeX 0.6s ease-in-out; }

      /* 20. Typewriter */
      @keyframes typewriter { from { width: 0; } to { width: 100%; } }
      .anim-typewriter { overflow: hidden; white-space: nowrap; animation: typewriter 2s steps(30) both; }

      /* 21. Glow */
      @keyframes glowAnim { 0%,100% { box-shadow: 0 0 5px rgba(120,119,198,0.2); } 50% { box-shadow: 0 0 20px rgba(120,119,198,0.6); } }
      .anim-glow { animation: glowAnim 2.5s ease-in-out infinite; }

      /* 22. Text Shimmer */
      @keyframes textShimmer { 0% { background-position: -200% center; } 100% { background-position: 200% center; } }
      .anim-text-shimmer { background: linear-gradient(90deg, currentColor 40%, #eab308 50%, currentColor 60%); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: textShimmer 3s ease-in-out infinite; }

      /* 23. Border Glow */
      @keyframes borderGlow { 0%,100% { border-color: rgba(120,119,198,0.2); } 50% { border-color: rgba(120,119,198,0.8); } }
      .anim-border-glow { animation: borderGlow 2s ease-in-out infinite; }

      /* 24. Gradient Shift */
      @keyframes gradientShift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
      .anim-gradient { background-size: 200% 200%; animation: gradientShift 4s ease infinite; }

      /* 25. Spin Slow */
      @keyframes spinSlow { from { transform: rotate(0); } to { transform: rotate(360deg); } }
      .anim-spin-slow { animation: spinSlow 10s linear infinite; }

      /* 26. Swing */
      @keyframes swing { 0%,100% { transform: rotate(0); } 20% { transform: rotate(15deg); } 40% { transform: rotate(-10deg); } 60% { transform: rotate(5deg); } 80% { transform: rotate(-5deg); } }
      .anim-swing { transform-origin: top center; animation: swing 1.5s ease-in-out; }

      /* 27. Jello */
      @keyframes jello { 0%,100% { transform: skewX(0) skewY(0); } 30% { transform: skewX(-12deg) skewY(-6deg); } 40% { transform: skewX(8deg) skewY(4deg); } 50% { transform: skewX(-4deg) skewY(-2deg); } 65% { transform: skewX(2deg) skewY(1deg); } 75% { transform: skewX(-1deg) skewY(0); } }
      .anim-jello { animation: jello 1s ease-in-out; }

      /* 28. Rubber Band */
      @keyframes rubberBand { 0%,100% { transform: scaleX(1) scaleY(1); } 30% { transform: scaleX(1.25) scaleY(0.75); } 40% { transform: scaleX(0.75) scaleY(1.25); } 50% { transform: scaleX(1.15) scaleY(0.85); } 65% { transform: scaleX(0.95) scaleY(1.05); } 75% { transform: scaleX(1.05) scaleY(0.95); } }
      .anim-rubber { animation: rubberBand 0.8s ease; }

      /* 29. Heartbeat */
      @keyframes heartbeat { 0%,100% { transform: scale(1); } 14% { transform: scale(1.3); } 28% { transform: scale(1); } 42% { transform: scale(1.3); } 70% { transform: scale(1); } }
      .anim-heartbeat { animation: heartbeat 1.5s ease-in-out infinite; }

      /* 30. Tada */
      @keyframes tada { 0%,100% { transform: scale(1) rotate(0); } 10%,20% { transform: scale(0.9) rotate(-3deg); } 30%,50%,70% { transform: scale(1.1) rotate(3deg); } 40%,60% { transform: scale(1.1) rotate(-3deg); } 80% { transform: scale(1) rotate(0); } }
      .anim-tada { animation: tada 1s ease; }

      /* 31. Zoom In Rotate */
      @keyframes zoomInRotate { from { opacity: 0; transform: scale(0.5) rotate(-30deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
      .anim-zoom-rotate { animation: zoomInRotate 0.7s ease-out both; }

      /* 32. Slide In Blur Left */
      @keyframes slideBlurLeft { from { opacity: 0; transform: translateX(-80px); filter: blur(8px); } to { opacity: 1; transform: translateX(0); filter: blur(0); } }
      .anim-slide-blur-left { animation: slideBlurLeft 0.7s ease-out both; }

      /* 33. Slide In Blur Right */
      @keyframes slideBlurRight { from { opacity: 0; transform: translateX(80px); filter: blur(8px); } to { opacity: 1; transform: translateX(0); filter: blur(0); } }
      .anim-slide-blur-right { animation: slideBlurRight 0.7s ease-out both; }

      /* 34. Bounce Soft */
      @keyframes bounceSoft { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
      .anim-bounce-soft { animation: bounceSoft 2s ease-in-out infinite; }

      /* 35. Skew In */
      @keyframes skewIn { from { opacity: 0; transform: skewX(-20deg); } to { opacity: 1; transform: skewX(0); } }
      .anim-skew-in { animation: skewIn 0.6s ease-out both; }

      /* 36. Drop In */
      @keyframes dropIn { 0% { opacity: 0; transform: translateY(-100px); } 60% { transform: translateY(10px); } 100% { opacity: 1; transform: translateY(0); } }
      .anim-drop-in { animation: dropIn 0.7s ease-out both; }

      /* 37. Stretch X */
      @keyframes stretchX { 0% { transform: scaleX(0); transform-origin: left; } 100% { transform: scaleX(1); transform-origin: left; } }
      .anim-stretch-x { animation: stretchX 0.6s ease-out both; }

      /* 38. Ripple */
      @keyframes ripple { 0% { box-shadow: 0 0 0 0 rgba(120,119,198,0.4); } 100% { box-shadow: 0 0 0 20px rgba(120,119,198,0); } }
      .anim-ripple { animation: ripple 1.5s ease-out infinite; }

      /* 39. Morph */
      @keyframes morph { 0%,100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; } 50% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; } }
      .anim-morph { animation: morph 5s ease-in-out infinite; }

      /* 40. Tracking In */
      @keyframes trackingIn { from { letter-spacing: -0.5em; opacity: 0; } to { letter-spacing: normal; opacity: 1; } }
      .anim-tracking-in { animation: trackingIn 0.8s cubic-bezier(0.215, 0.61, 0.355, 1) both; }

      /* 41. Focus In */
      @keyframes focusIn { from { filter: blur(12px); opacity: 0; } to { filter: blur(0); opacity: 1; } }
      .anim-focus-in { animation: focusIn 0.8s cubic-bezier(0.55, 0.085, 0.68, 0.53) both; }

      /* 42. Unfold */
      @keyframes unfold { from { max-height: 0; opacity: 0; } to { max-height: 500px; opacity: 1; } }
      .anim-unfold { overflow: hidden; animation: unfold 0.8s ease-out both; }

      /* 43. Pop */
      @keyframes pop { 0% { transform: scale(0); } 80% { transform: scale(1.15); } 100% { transform: scale(1); } }
      .anim-pop { animation: pop 0.4s cubic-bezier(0.26, 0.53, 0.74, 1.48) both; }

      /* 44. Sway */
      @keyframes sway { 0%,100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
      .anim-sway { animation: sway 3s ease-in-out infinite; }

      /* 45. Ken Burns */
      @keyframes kenBurns { 0% { transform: scale(1) translate(0, 0); } 100% { transform: scale(1.15) translate(-2%, -2%); } }
      .anim-ken-burns { animation: kenBurns 15s ease-in-out infinite alternate; }

      /* 46. Color Cycle Text */
      @keyframes colorCycle { 0% { color: #eab308; } 25% { color: #8b5cf6; } 50% { color: #06b6d4; } 75% { color: #10b981; } 100% { color: #eab308; } }
      .anim-color-cycle { animation: colorCycle 6s ease infinite; }

      /* 47. Counter spin */
      @keyframes counterSpin { from { transform: rotate(360deg); } to { transform: rotate(0); } }
      .anim-counter-spin { animation: counterSpin 12s linear infinite; }

      /* 48. Line Reveal */
      @keyframes lineReveal { from { width: 0; } to { width: 100%; } }
      .anim-line-reveal::after { content: ''; display: block; height: 2px; background: #eab308; animation: lineReveal 1s ease-out both; }

      /* 49. Parallax Drift */
      @keyframes parallaxDrift { 0%,100% { transform: translate(0,0); } 25% { transform: translate(5px,-5px); } 50% { transform: translate(-3px,3px); } 75% { transform: translate(3px,2px); } }
      .anim-parallax-drift { animation: parallaxDrift 8s ease-in-out infinite; }

      /* 50. Neon Blink */
      @keyframes neonBlink { 0%,100% { text-shadow: 0 0 4px rgba(234,179,8,0.4), 0 0 11px rgba(234,179,8,0.2); } 50% { text-shadow: 0 0 8px rgba(234,179,8,0.8), 0 0 20px rgba(234,179,8,0.4), 0 0 30px rgba(234,179,8,0.2); } }
      .anim-neon-blink { animation: neonBlink 2s ease-in-out infinite; }

      /* ── Stagger delays ── */
      .delay-1 { animation-delay: 0.1s; }
      .delay-2 { animation-delay: 0.2s; }
      .delay-3 { animation-delay: 0.3s; }
      .delay-4 { animation-delay: 0.4s; }
      .delay-5 { animation-delay: 0.5s; }
      .delay-6 { animation-delay: 0.6s; }
      .delay-7 { animation-delay: 0.7s; }
      .delay-8 { animation-delay: 0.8s; }
      .delay-9 { animation-delay: 0.9s; }
      .delay-10 { animation-delay: 1.0s; }

      /* ── Intersection Observer Driven Animations ── */
      [data-anim] { opacity: 0; }
      [data-anim].is-visible { opacity: 1; }
    </style>

    <script is:inline>
      // Intersection Observer for scroll-triggered animations
      document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const animClass = el.getAttribute('data-anim');
              if (animClass) {
                el.classList.add(animClass, 'is-visible');
              }
              observer.unobserve(el);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('[data-anim]').forEach(el => observer.observe(el));
      });

      // Re-run on Astro page transitions
      document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const animClass = el.getAttribute('data-anim');
              if (animClass) {
                el.classList.add(animClass, 'is-visible');
              }
              observer.unobserve(el);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('[data-anim]').forEach(el => {
          el.classList.remove('is-visible');
          const animClass = el.getAttribute('data-anim');
          if (animClass) el.classList.remove(animClass);
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>
